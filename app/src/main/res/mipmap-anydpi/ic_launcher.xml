<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MonochromeLauncherIcon">
    <!-- No <monochrome> layer on purpose: the icon is a detailed picture, as a silhouette it would be a solid
         blob in a themed icon. A themed icon needs a simple one-colour glyph of its own. -->
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>